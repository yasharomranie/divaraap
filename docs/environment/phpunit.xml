<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="/app/vendor/autoload.php" colors="false" cacheDirectory="/setup/phpunit-cache">
  <testsuites><testsuite name="Baseline"><directory>/app/tests/Feature</directory></testsuite></testsuites>
  <php>
    <env name="APP_ENV" value="testing" force="true"/>
    <env name="DB_CONNECTION" value="pgsql" force="true"/>
    <env name="DB_HOST" value="divaraap-db" force="true"/>
    <env name="DB_DATABASE" value="openclassify_testing" force="true"/>
    <env name="CACHE_STORE" value="array" force="true"/>
    <env name="SESSION_DRIVER" value="array" force="true"/>
    <env name="QUEUE_CONNECTION" value="sync" force="true"/>
    <env name="BROADCAST_CONNECTION" value="log" force="true"/>
    <env name="MAIL_MAILER" value="array" force="true"/>
    <env name="BCRYPT_ROUNDS" value="4" force="true"/>
    <env name="PUBLIC_STORAGE_ROOT" value="/setup/testing-public" force="true"/>
  </php>
</phpunit>
