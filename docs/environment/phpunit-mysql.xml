<phpunit bootstrap="/app/vendor/autoload.php" colors="false" cacheDirectory="/setup/phpunit-cache">
  <testsuites>
    <testsuite name="Baseline">
      <directory>/app/tests/Feature</directory>
    </testsuite>
  </testsuites>
  <php>
    <ini name="memory_limit" value="512M" />
    <env name="APP_ENV" value="testing" force="true" />
    <env name="DB_CONNECTION" value="mysql" force="true" />
    <env name="DB_HOST" value="divaraap-mysql" force="true" />
    <env name="DB_DATABASE" value="divaraap_shared_testing" force="true" />
    <env name="CACHE_STORE" value="array" force="true" />
    <env name="SESSION_DRIVER" value="array" force="true" />
    <env name="QUEUE_CONNECTION" value="sync" force="true" />
    <env name="BROADCAST_CONNECTION" value="log" force="true" />
    <env name="MAIL_MAILER" value="array" force="true" />
    <env name="BCRYPT_ROUNDS" value="4" force="true" />
    <env name="PUBLIC_STORAGE_ROOT" value="/setup/mysql-testing-public" force="true" />
    <env name="DB_PORT" value="3306" force="true" />
    <env name="DB_USERNAME" value="divaraap" force="true" />
  </php>
</phpunit>